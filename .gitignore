# build artifacts
build/
Debug/
Release/
Drivers/
Middlewares/

# IDE files
.idea/
*.mxproject

# CubeIDE/Eclipse files
*.metadata
*.launch
*.project
*.cproject
*.settings/
*.htm
*.log

# CubeMX generated
*.ioc.save
_*/

# Auto-generated
*.lst
*.map
*.o
*.d
*.elf
*.bin
*.hex


# --- Lattice FPGA: Keep Source, Ignore Artifacts ---
fpga/*/
!fpga/
!fpga/*.v      # Keep Verilog source
!fpga/*.lpf    # Keep Pin Assignments (Constraints)
!fpga/*.ldf    # Keep Lattice Project File
!fpga/*.ccl    # Keep Communication Constraint files
!fpga/*.sty    # Keep Strategy files

# Ignore specific Lattice noise
fpga/impl1/
fpga/sim/
fpga/test/
fpga/transcript
fpga/*.dir/
fpga/*.html
fpga/*.xml
fpga/*.log

# --- Python / Data ---
__pycache__/
*.pyc
*.log

# Local safety-net backups, not source
backups/

# Calibration run history: keep only the stable "latest" pointer
host_CAN/HW_tests/calibrations/*.json
!host_CAN/HW_tests/calibrations/latest.json


# Lattice Diamond editor state
fpga/.*.ini
